{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for YouTube Desktop",
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["main"],
  "remote": {
    "urls": ["https://www.youtube.com/*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-set-always-on-top",
    "core:window:allow-is-always-on-top",
    "core:window:allow-set-title",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:tray:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-is-always-on-top",
    "core:window:allow-set-always-on-top",
    "allow-tabs-list",
    "allow-profile-list",
    "allow-profile-select",
    "allow-profile-create",
    "allow-tab-new",
    "allow-tab-new-url",
    "allow-tab-close",
    "allow-tab-switch",
    "allow-tab-navigated",
    "allow-queue-list",
    "allow-queue-add",
    "allow-queue-remove",
    "allow-queue-move",
    "allow-queue-clear",
    "allow-queue-play",
    "allow-queue-play-next",
    "allow-queue-toggle",
    "allow-clean-view-toggle",
    "allow-history-list",
    "allow-bookmark-list",
    "allow-bookmark-add",
    "allow-bookmark-remove",
    "allow-library-panel-toggle",
    "allow-tab-back",
    "allow-tab-forward",
    "allow-tab-reload",
    "allow-tab-navigate",
    "allow-tab-toggle-theater",
    "allow-win-minimize",
    "allow-win-toggle-maximize",
    "allow-win-toggle-fullscreen",
    "allow-win-close",
    "allow-webview-fullscreen-changed",
    "allow-set-titlebar-hidden",
    "allow-show-titlebar"
  ]
}
